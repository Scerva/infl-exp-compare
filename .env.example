# Copy this file to .env and fill in real values. Never commit .env.

# FRED API key (required). Obtain at https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# Optional: override default HTTP User-Agent used for scraping Fed Board / FOMC pages.
SCRAPER_USER_AGENT="infl-exp-compare-research/0.1 (contact: set-your-email@example.com)"

# Optional: root directory overrides (default to ./data, ./output if unset)
DATA_DIR=data
OUTPUT_DIR=output
